# Database Configuration

# for sqlite3
DATABASE_URL=sqlite:///meridian.db
# for postgresql
# DATABASE_URL=postgresql://$(username):$(password)@localhost:5432/$(meridiano)

# API Keys
# Com litellm, os modelos usam o formato provedor/modelo.
# Se você usar Gemini para tudo, basta configurar a chave abaixo:
GEMINI_API_KEY=your_gemini_api_key_here

# Configuração de Modelos Padrão (Gemini)
LLM_CHAT_MODEL=gemini/gemma-3-4b
EMBEDDING_MODEL=gemini/text-embedding-004

# ── Perfis Gemini e Limites (Ref. llm_manager.py) ─────────────────────────
# Perfil A – Pesado   : gemini/gemini-2.0-flash-lite  → 15 RPM / 500 RPD
# Perfil B – Pesado   : gemini/gemma-3-4b-it          → 30 RPM / 14000 RPD
# Perfil C – Simples  : gemini/gemini-2.5-flash-preview-04-17 → 10 RPM / 20 RPD

# Embeddings Gemini
# EMBEDDING_MODEL=gemini/text-embedding-004
# EMBEDDING_MODEL=gemini/gemini-embedding-exp-03-07

# Rate limiting manual (sobrescreve os padrões do perfil se definido)
# LLM_RPM=15
# LLM_RPD=500

# For use with ollama
OLLAMA_API_BASE=http://localhost:11434
# LLM_CHAT_MODEL=ollama/qwen3:30b
# EMBEDDING_MODEL=ollama/nomic-embed-text

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development
